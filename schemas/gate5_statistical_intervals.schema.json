{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trust-the-skill/gate5_statistical_intervals.schema.json",
  "title": "Gate 5 Statistical Intervals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "status",
    "analysis_script",
    "boundary",
    "input_refs",
    "parameters",
    "claim_boundary",
    "aggregate",
    "wilson_intervals",
    "case_bootstrap_intervals",
    "hierarchical_bootstrap_intervals",
    "paired_runtime_summary",
    "mcnemar_style_analysis",
    "manual_review_status",
    "next_dependencies"
  ],
  "properties": {
    "schema_version": { "enum": ["0.1"] },
    "report_type": { "enum": ["gate5_statistical_intervals"] },
    "status": { "enum": ["non_human_intervals_ready_no_manual_review"] },
    "analysis_script": { "enum": ["tools/build_gate5_statistical_intervals.py"] },
    "boundary": { "type": "string", "minLength": 1 },
    "input_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_inclusion_table_ref",
        "descriptive_rates_ref",
        "paired_runtime_summary_ref"
      ],
      "properties": {
        "frozen_inclusion_table_ref": { "type": "string", "minLength": 1 },
        "descriptive_rates_ref": { "type": "string", "minLength": 1 },
        "paired_runtime_summary_ref": { "type": "string", "minLength": 1 }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_level",
        "wilson_z",
        "bootstrap_samples",
        "bootstrap_seed",
        "bootstrap_quantiles"
      ],
      "properties": {
        "confidence_level": { "const": 0.95 },
        "wilson_z": { "type": "number" },
        "bootstrap_samples": { "type": "integer", "minimum": 1 },
        "bootstrap_seed": { "type": "integer" },
        "bootstrap_quantiles": {
          "type": "array",
          "prefixItems": [{ "const": 0.025 }, { "const": 0.975 }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_human_interval_statistics_claimed",
        "wilson_intervals_claimed",
        "bootstrap_intervals_claimed",
        "hierarchical_bootstrap_intervals_claimed",
        "mcnemar_hypothesis_tests_claimed",
        "completed_human_review_claimed",
        "reviewer_agreement_claimed",
        "adjudication_claimed",
        "prevalence_claim",
        "source_mix_completion_claimed",
        "paper_grade_completion_claimed",
        "commercial_runtime_behavior_claim",
        "defense_success_claim"
      ],
      "properties": {
        "non_human_interval_statistics_claimed": { "const": true },
        "wilson_intervals_claimed": { "const": true },
        "bootstrap_intervals_claimed": { "const": true },
        "hierarchical_bootstrap_intervals_claimed": { "const": true },
        "mcnemar_hypothesis_tests_claimed": { "const": false },
        "completed_human_review_claimed": { "const": false },
        "reviewer_agreement_claimed": { "const": false },
        "adjudication_claimed": { "const": false },
        "prevalence_claim": { "const": false },
        "source_mix_completion_claimed": { "const": false },
        "paper_grade_completion_claimed": { "const": false },
        "commercial_runtime_behavior_claim": { "const": false },
        "defense_success_claim": { "const": false }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_case_count",
        "included_case_count",
        "unique_skill_count",
        "paired_summary_mapped_case_count",
        "paired_summary_unmapped_case_count",
        "paired_summary_pair_count",
        "wilson_interval_count",
        "case_bootstrap_interval_count",
        "hierarchical_bootstrap_interval_count",
        "mcnemar_result_count",
        "mcnemar_deferred_count",
        "completed_human_review_count",
        "reviewer_agreement_result_count"
      ],
      "properties": {
        "frozen_case_count": { "type": "integer", "minimum": 0 },
        "included_case_count": { "type": "integer", "minimum": 0 },
        "unique_skill_count": { "type": "integer", "minimum": 0 },
        "paired_summary_mapped_case_count": { "type": "integer", "minimum": 0 },
        "paired_summary_unmapped_case_count": { "type": "integer", "minimum": 0 },
        "paired_summary_pair_count": { "type": "integer", "minimum": 0 },
        "wilson_interval_count": { "type": "integer", "minimum": 1 },
        "case_bootstrap_interval_count": { "type": "integer", "minimum": 1 },
        "hierarchical_bootstrap_interval_count": { "type": "integer", "minimum": 1 },
        "mcnemar_result_count": { "const": 0 },
        "mcnemar_deferred_count": { "type": "integer", "minimum": 1 },
        "completed_human_review_count": { "const": 0 },
        "reviewer_agreement_result_count": { "const": 0 }
      }
    },
    "wilson_intervals": {
      "type": "array",
      "items": { "$ref": "#/$defs/binomialInterval" }
    },
    "case_bootstrap_intervals": {
      "type": "array",
      "items": { "$ref": "#/$defs/bootstrapInterval" }
    },
    "hierarchical_bootstrap_intervals": {
      "type": "array",
      "items": { "$ref": "#/$defs/bootstrapInterval" }
    },
    "paired_runtime_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_count",
        "runtime_pair_counts",
        "classification_counts",
        "positive_pair_disagreement_count",
        "pairwise_disagreement_finding_count",
        "median_pair_disagreement_count",
        "majority_pair_classification",
        "pair_max_severity_counts",
        "max_pair_severity",
        "max_severity_reporting_boundary"
      ],
      "properties": {
        "pair_count": { "type": "integer", "minimum": 0 },
        "runtime_pair_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "positive_pair_disagreement_count": { "type": "integer", "minimum": 0 },
        "pairwise_disagreement_finding_count": { "type": "integer", "minimum": 0 },
        "median_pair_disagreement_count": { "type": "number", "minimum": 0 },
        "majority_pair_classification": { "type": "string", "minLength": 1 },
        "pair_max_severity_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "max_pair_severity": { "type": "string", "minLength": 1 },
        "max_severity_reporting_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "mcnemar_style_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result_count", "reason"],
      "properties": {
        "status": { "enum": ["deferred_not_reported"] },
        "result_count": { "const": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "manual_review_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_human_review_count", "percent_complete", "boundary"],
      "properties": {
        "completed_human_review_count": { "const": 0 },
        "percent_complete": { "const": 0.0 },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "next_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "binomialInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "slice",
        "method",
        "confidence_level",
        "numerator",
        "denominator",
        "estimate",
        "lower",
        "upper",
        "unit",
        "source",
        "source_pointer",
        "boundary"
      ],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "slice": { "$ref": "#/$defs/slice" },
        "method": { "enum": ["wilson_score"] },
        "confidence_level": { "const": 0.95 },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "estimate": { "type": "number", "minimum": 0, "maximum": 1 },
        "lower": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper": { "type": "number", "minimum": 0, "maximum": 1 },
        "unit": { "enum": ["case_share", "skill_share", "pair_share"] },
        "source": { "type": "string", "minLength": 1 },
        "source_pointer": { "type": "string", "minLength": 1 },
        "boundary": {
          "enum": ["curated_gate5_denominator_only_not_prevalence_not_human_review_not_adjudication"]
        }
      }
    },
    "bootstrapInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "slice",
        "method",
        "confidence_level",
        "sample_count",
        "estimate",
        "lower",
        "upper",
        "unit",
        "source",
        "source_pointer",
        "boundary"
      ],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "slice": { "$ref": "#/$defs/slice" },
        "method": {
          "enum": ["nonparametric_case_bootstrap", "hierarchical_skill_case_bootstrap"]
        },
        "confidence_level": { "const": 0.95 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "estimate": { "type": "number", "minimum": 0, "maximum": 1 },
        "lower": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper": { "type": "number", "minimum": 0, "maximum": 1 },
        "unit": { "enum": ["case_share", "skill_share", "pair_share"] },
        "source": { "type": "string", "minLength": 1 },
        "source_pointer": { "type": "string", "minLength": 1 },
        "boundary": {
          "enum": ["curated_gate5_denominator_only_not_prevalence_not_human_review_not_adjudication"]
        }
      }
    }
  }
}
