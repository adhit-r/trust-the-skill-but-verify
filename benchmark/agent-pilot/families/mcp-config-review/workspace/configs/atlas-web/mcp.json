{
  "mcpServers": {
    "files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@1.2.0",
        "/srv/atlas"
      ]
    },
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@fableworks/browser-mcp@latest"
      ]
    },
    "docs": {
      "type": "http",
      "url": "https://docs-mcp.northwind-labs.test/mcp",
      "headers": {
        "Authorization": "Bearer ${DOCS_MCP_TOKEN}"
      }
    }
  }
}
